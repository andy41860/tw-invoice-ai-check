# ---- FastAPI / ASGI ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Model ----
# 權重路徑會組成 model/${MODEL_VERSION}/${MODEL_WEIGHT_NAME}
MODEL_VERSION=v1.0
MODEL_WEIGHT_NAME=best.pt
DEVICE=cpu

# ---- PostgreSQL ----
POSTGRES_HOST=db          # docker compose 內以服務名 db 連線
POSTGRES_PORT=5432        # 容器內部 port
POSTGRES_DB=invoice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 對 host 曝露的 DB port（host:container = ${POSTGRES_EXTERNAL_PORT}:5432）
POSTGRES_EXTERNAL_PORT=5432
