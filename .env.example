# ---- FastAPI / ASGI ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Model ----
# 權重路徑會組成 model/${MODEL_VERSION}/${MODEL_WEIGHT_NAME}
MODEL_VERSION=v1.0
MODEL_WEIGHT_NAME=best.pt
DEVICE=cpu

# ---- PostgreSQL ----
POSTGRES_HOST=db          # docker compose 內以服務名 db 連線
POSTGRES_PORT=5432        # 容器內部 port
POSTGRES_DB=invoice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 對 host 曝露的 DB port（host:container = ${POSTGRES_EXTERNAL_PORT}:5432）
POSTGRES_EXTERNAL_PORT=5432

# ---- Go Batch Service ----
# Go batch 呼叫 FastAPI 的 URL（docker 內部預設用服務名 api）
BATCH_API_URL=http://api:8000
# Host 端要掛載進容器的圖片目錄（相對路徑或絕對路徑）
BATCH_INPUT_DIR=./test_samples
# 容器內的掛載路徑（對應 batch service 的 INPUT_DIR 環境變數）
CONTAINER_BATCH_INPUT_DIR=/data/test_samples
# Worker 並行數
BATCH_WORKERS=2
